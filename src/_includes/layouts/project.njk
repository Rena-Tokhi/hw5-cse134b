---
layout: layouts/base.njk
---
<p><a href="/projects/">&larr; Back to all projects</a></p>

<article>
  <h1>{{ title }}{% if flagship %} <span>(Flagship Project)</span>{% endif %}</h1>
  <img src="{{ image }}" alt="{{ imageAlt }}" width="800" height="450">

  <section id="tech-stack">
    <h2>Tech Stack</h2>
    <div class="tags">
      {%- for tag in stack %}
      <skill-tag>{{ tag }}</skill-tag>
      {%- endfor %}
    </div>
  </section>

  <section id="problem">
    <h2>The Problem</h2>
    <p>{{ problem | safe }}</p>
  </section>

  <section id="role">
    <h2>My Role</h2>
    <p>{{ role | safe }}</p>
  </section>

  <section id="outcome">
    <h2>Outcome</h2>
    <p>{{ outcome | safe }}</p>
    {% if video %}
    <iframe width="480" height="270" src="{{ video }}" title="{{ title }} project demo video" allowfullscreen></iframe>
    {% endif %}
  </section>

  <p><a href="{{ github }}" target="_blank" rel="noopener">View on GitHub</a></p>
</article>
